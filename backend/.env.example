NODE_ENV=development
PORT=3000

# Database Configuration:
# - Production / Staging: Provide PostgreSQL connection URL (e.g., NeonDB)
# - Local Development: Leave DATABASE_URL empty or set USE_SQLITE=true to use SQLite
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/eminence_db
USE_SQLITE=false

# Seeding Configuration:
# - Set DEMO_SEED=true to seed initial demo accounts (customers, drivers, vehicles, admin)
# - When USE_SQLITE=true and NODE_ENV=development, seeding runs automatically
DEMO_SEED=false

# Redis Cache (Optional)
# - Leave empty to use in-memory LRU cache
# - For production, use a provider like Upstash (https://upstash.com) or Redis Labs
REDIS_URL=rediss://default:password@your-redis-endpoint.upstash.io:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Fast2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Google Maps
GOOGLE_MAPS_API_KEY=your_key_here

# Razorpay (Phase 2)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# WhatsApp (Phase 2)
WHATSAPP_BUSINESS_PHONE_ID=your_phone_id
WHATSAPP_ACCESS_TOKEN=your_token

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@eminence.com
SMTP_PASS=app_password_here
SMTP_FROM=noreply@eminence.com

# Frontend URL
REACT_APP_API_URL=http://localhost:5173

# Seed/Demo User
SEED_EMAIL=admin@example.com
SEED_PASSWORD=password123

GROQ_API_KEY="your-real-groq-key-here"